# Copy to .env and adjust if needed. .env itself is gitignored (decision #7).

# Your Mac user's UID/GID, so containers write files you own, not root.
# Check with `id -u` / `id -g`.
PUID=501
PGID=20

# System timezone, e.g. America/New_York. Check with:
# readlink /etc/localtime | sed 's#.*/zoneinfo/##'
TZ=Etc/UTC

# Absolute path to the data root (decision #1). Must NOT be inside this repo.
DATA_ROOT=/Users/YOUR_USERNAME/neoflix-data
