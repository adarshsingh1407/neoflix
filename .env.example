# Copy to .env and adjust if needed. .env itself is gitignored (decision #7).
#
# PUID/PGID/TZ/DATA_ROOT/NEOFLIX_REPO_ROOT/JELLYFIN_API_KEY below are all
# filled in automatically by `python3 scripts/bootstrap.py` (`python` on
# Windows) -- decision #13. Only edit them by hand if you're setting things
# up without running that script.

# Your user account's UID/GID, so containers write files you own, not root.
# On macOS/Linux, check with `id -u` / `id -g`. Windows has no equivalent
# concept -- bootstrap.py defaults to 1000/1000 there (linuxserver.io's own
# documented default; Docker Desktop's Windows backend handles bind-mount
# permissions itself, so this isn't load-bearing the way it is elsewhere).
PUID=501
PGID=20

# System timezone, e.g. America/New_York. On macOS/Linux, check with:
# readlink /etc/localtime | sed 's#.*/zoneinfo/##'
TZ=Etc/UTC

# Absolute path to the data root (decision #1). Must NOT be inside this repo.
# macOS/Linux example: /Users/YOUR_USERNAME/neoflix-data
# Windows example (use forward slashes): C:/Users/YOUR_USERNAME/neoflix-data
DATA_ROOT=/Users/YOUR_USERNAME/neoflix-data

# This repo's own absolute path, used by Ofelia's job labels to mount
# scripts/ofelia regardless of which shell/OS invoked `docker compose up`
# (decision #13's follow-up). bootstrap.py writes this on every run --
# no need to fill it in yourself.
NEOFLIX_REPO_ROOT=

# Jellyfin API key, used by the Ofelia poster-grid job to read library posters
# and push generated collage images back. bootstrap.py creates one and writes
# it here automatically (decision #13) -- only fill this in yourself if you
# set Jellyfin up by hand instead (Dashboard > Advanced > API Keys).
JELLYFIN_API_KEY=your_jellyfin_api_key

# Radarr/Sonarr/Jellyseerr API keys, used by the lifecycle service (decision
# #14) to poll each app's queue/request state for the Homepage dashboard
# widget. bootstrap.py reads these live off each app and writes them here
# automatically -- only fill in by hand if you set things up without running
# that script (Radarr/Sonarr: Settings > General; Jellyseerr: Settings > General).
RADARR_API_KEY=your_radarr_api_key
SONARR_API_KEY=your_sonarr_api_key
JELLYSEERR_API_KEY=your_jellyseerr_api_key
