# Copy to credentials.env (gitignored, never commit it) and fill in before
# running `scripts/bootstrap.sh`. This is the only manual input the bootstrap
# script needs — everything else (folders, admin accounts, indexers, download
# client, quality profiles, dashboard) gets wired up automatically from these.

# One username/password, reused everywhere a *new* account gets created:
# qBittorrent WebUI, Jellyfin admin, Uptime Kuma admin. Pick a real password —
# these are accounts reachable on your LAN, not throwaway values.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Bazarr's subtitle provider needs a real OpenSubtitles.com account (free to
# create at https://www.opensubtitles.com/en/users/newuser if you don't have
# one). Leave both blank to skip subtitle-provider setup — you can add it
# later by hand in Bazarr's UI (Settings > Providers).
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=
